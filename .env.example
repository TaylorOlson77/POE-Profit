# Neon / local database
# Copy to `.env.local` (or use `neon link` / `neon env pull`). Never commit secrets.

# Pooled connection — used by the Next.js app / Prisma Client at runtime
DATABASE_URL=

# Direct (unpooled) connection — used by Prisma migrations (`directUrl`)
DATABASE_URL_UNPOOLED=

# Set by Neon CLI when a branch is linked
NEON_BRANCH=
