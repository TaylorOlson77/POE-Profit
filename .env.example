# Never commit real values.
# .env.local — Neon branch local. The two URLs only. Leave DATABASE_RESET unset.
# .env.neon-production — the same two URLs, and DATABASE_RESET=production.
# .env.neon-ci — the same two URLs, and DATABASE_RESET=ci. No script loads that file.
# GitHub secrets are the ci URLs only, named CI_DATABASE_URL and CI_DATABASE_URL_UNPOOLED.

# Pooled connection. Hostname includes -pooler. App and Prisma Client.
DATABASE_URL=

# Direct connection. Same string with -pooler removed from the host. Migrations.
DATABASE_URL_UNPOOLED=

# production or ci. Not used for local.
DATABASE_RESET=
