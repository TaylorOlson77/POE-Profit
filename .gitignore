# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
_list.txt
_pkg.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example templates commit-able
.env
.env.*
!.env.example

# vercel / neon local
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# local install noise
npm-prisma-install.log

# local Cursor IDE state
.cursor/settings.json

# Local study notes (not product docs)
docs/INTERVIEW_PREP.md
docs/RECOMMENDED_READING.md
docs/COMPETITIVE_ANALYSIS.md

# Resume source and PDF exports
/resume/

# Local AI agent context (kept on disk for Cursor, not published)
/AGENTS.md
/docs/AGENTS.md
/.agents/
/skills-lock.json

# Unused create-next-app icons
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg
